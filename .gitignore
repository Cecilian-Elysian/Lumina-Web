# 系统与编辑器杂项
.DS_Store
Thumbs.db
desktop.ini

# 编辑器目录
.vscode/
.idea/

# 本地临时文件
*.log
*.tmp
node_modules/

# ⚠️ 密钥文件（wrangler 本地环境变量，绝不提交）
.dev.vars
.dev.vars.*

# wrangler 本地开发产物（缓存/状态数据库/打包临时文件）
.wrangler/

# Cloudflare Pages 构建产物
/dist/

# Manager 控制台仅保存在本机，不上传 GitHub
/manager/

# Tools 运行产物（Tools 源码和依赖锁文件正常入库）
tools/node_modules/
tools/weights/
tools/.tmp/
tools/.cache/

# 空的占位目录（永远不会进构建产物）
/assets/

# 编辑器/备份残留（防御性）
*.bak
*.swp
*~
