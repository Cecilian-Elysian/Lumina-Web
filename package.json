{
  "name": "lumina",
  "version": "2.0.0",
  "description": "Lumina — 流动图片墙 + 光影画廊 (Vue 3 + Vite + TS)",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:manager": "vite build --mode manager",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:schema:local": "npx wrangler d1 execute lumina-db --local --file schema.sql",
    "db:schema:remote": "npx wrangler d1 execute lumina-db --remote --file schema.sql"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.0",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
